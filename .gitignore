# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# 缓存
*.log
*.tmp

# IDE
.vscode/
.idea/

# WorkBuddy — memory/automations/skills 保留版本控制（项目约定与知识库运维记忆）
# 仅忽略瞬态会话状态，避免每次运行产生 git 噪声
.workbuddy/tasks/
.workbuddy/heartbeat/
.workbuddy/logs/
*.db

# 临时/产出目录（一次性脚本的中间产物，不入库）
.kbtmp/
.scripts_tmp/

# 系统
.DS_Store

# Obsidian 本地工作区/图谱/插件状态（随每次打开变化，不入库）
# 保留版本化：app.json / appearance.json / community-plugins.json / core-plugins.json / plugins/*/manifest.json
knowledge_base/.obsidian/workspace.json
knowledge_base/.obsidian/workspace-mobile.json
knowledge_base/.obsidian/graph.json
knowledge_base/.obsidian/cache/
knowledge_base/.obsidian/plugins/*/data.json

# 本地 AI 工具状态（claudian/opencode，非知识库内容）
knowledge_base/.claudian/

# Smart Connections 向量嵌入缓存（随每次 reindex 膨胀，含笔记正文切片，不入库）
knowledge_base/.smart-env/

# Obsidian Copilot 插件向各 agent 工具目录镜像的 skills（同一套 38 文件被镜像 4 份，
# blob 集指纹一致 d72ad24f4bdf，工具生成可重建，非知识库内容）
knowledge_base/.agents/
knowledge_base/.claude/
knowledge_base/.opencode/
knowledge_base/copilot/

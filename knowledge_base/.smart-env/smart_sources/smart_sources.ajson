"smart_sources:copilot/skills/obsidian-cli/SKILL.md": {"class_name":"SmartSource","last_read":{"hash":"14eknn3","at":1786721902368},"embedding":{"history":[]},"path":"copilot/skills/obsidian-cli/SKILL.md","last_import":{"mtime":1786721215706,"size":9971,"at":1786721902410,"hash":"14eknn3"},"outlinks":[],"metadata":{"name":"obsidian-cli","description":"Use the official Obsidian CLI when a task needs Obsidian's running app, index, configured features, command registry, or developer runtime. Use for currently open notes and tabs, workspace state, daily notes, typed properties, tasks, links/backlinks, Bases queries, template resolution, link-aware moves, plugin commands, and plugin/theme debugging; do not use it for ordinary filesystem operations.","license":"MIT","metadata":{"copilot-enabled-agents":"claude, codex, opencode","copilot-builtin-version":"2","copilot-upstream-revision":"a1dc48e68138490d522c04cbf5822214c6eb1202"}},"blocks_data":{"#---frontmatter---":{"text":null,"length":0,"last_read":{"hash":"trm81g","at":1786721902368},"key":"copilot/skills/obsidian-cli/SKILL.md#---frontmatter---","lines":[1,9],"size":615,"should_embed":true},"#Obsidian CLI":{"text":null,"length":0,"last_read":{"hash":"11a7777","at":1786721902368},"key":"copilot/skills/obsidian-cli/SKILL.md#Obsidian CLI","lines":[11,221],"size":9350,"should_embed":false},"#Obsidian CLI#{1}":{"text":null,"length":0,"last_read":{"hash":"ypcomy","at":1786721902368},"key":"copilot/skills/obsidian-cli/SKILL.md#Obsidian CLI#{1}","lines":[13,17],"size":240,"should_embed":true},"#Obsidian CLI#Capability probe and fallback":{"text":null,"length":0,"last_read":{"hash":"1ll8212","at":1786721902368},"key":"copilot/skills/obsidian-cli/SKILL.md#Obsidian CLI#Capability probe and fallback","lines":[18,56],"size":1626,"should_embed":false},"#Obsidian CLI#Capability probe and fallback#{1}":{"text":null,"length":0,"last_read":{"hash":"c3v0e1","at":1786721902368},"key":"copilot/skills/obsidian-cli/SKILL.md#Obsidian CLI#Capab